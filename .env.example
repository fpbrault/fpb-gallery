# Public Sanity dataset coordinates (safe to expose to the browser)
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-07-01
NEXT_PUBLIC_SANITY_USE_CDN=true

# Canonical production origin, without a trailing slash
NEXT_PUBLIC_SITE_URL=https://example.com

# Server-only. Never prefix these with NEXT_PUBLIC_.
SANITY_API_READ_TOKEN=replace-with-viewer-token
SANITY_WEBHOOK_SECRET=replace-with-webhook-secret

# Optional: run Playwright against an existing deployment
# PLAYWRIGHT_BASE_URL=https://preview.example.com
